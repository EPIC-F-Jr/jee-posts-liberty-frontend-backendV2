<div class="posts-container">
  <h2>✨ Latest Posts</h2>

  <div *ngIf="loading" class="loading">
    <div class="loading-spinner"></div>
    Loading posts...
  </div>

  <div *ngIf="error" class="error">
    <strong>Oops! Something went wrong</strong><br>
    {{ error }}
  </div>

  <div *ngIf="!loading && !error">
    <div *ngIf="postDTO.length === 0" class="no-posts">
      <div class="no-posts-icon">📝</div>
      <h3>No posts available yet</h3>
      <p>Be the first to share something amazing!</p>
    </div>

    <div *ngFor="let post of postDTO; let i = index" class="post-card" [attr.data-index]="i" #postCard
      [style.animation-delay.ms]="i * 100">

      <div class="post-header">
        <div class="user-info">
          <strong>{{ (post && post.post && post.post.user && post.post.user.username) || 'Anonymous User' }}</strong>
          <small>@{{ (post && post.post && post.post.user && post.post.user.id) || 'unknown' }}</small>
        </div>

<div class="post-actions-wrapper" #postActions>
  <button class="post-actions-btn" (click)="togglePostOptions(post); $event.stopPropagation()">⋯</button>

  <!-- Updated class name -->
  <div class="options-bubble" [class.visible]="post.showOptions">
    <button (click)="openShareOptions(post)">🔗 Share</button>
    <button *ngIf="post.post && post.post.user && post.post.user.id === getCurrentUserId()" (click)="editPost(post)">✏️ Edit</button>
    <button *ngIf="post.post && post.post.user && post.post.user.id === getCurrentUserId()" (click)="deletePost(post)">🗑️ Delete</button>
  </div>
</div>

        <div class="post-date">
          <span class="date-badge">{{ getCurrentDate() }}</span>
        </div>
      </div>

      <div class="post-content">
        <!-- Edit mode for post content -->
        <div *ngIf="post.post && isEditingPost(post.post.id)" class="post-edit-mode">
          <div class="edit-input-container">
            <textarea
              class="post-edit-input"
              [(ngModel)]="editPostContent"
              rows="4"
              maxlength="1000"
              placeholder="Edit your post...">
            </textarea>
            <div class="edit-char-count">{{ editPostContent.length }}/1000</div>
          </div>
          <div class="edit-actions">
            <button class="edit-cancel-btn" (click)="cancelPostEdit()" [disabled]="submittingPostEdit">
              Cancel
            </button>
            <button class="edit-save-btn" (click)="savePostEdit(post)"
                    [disabled]="!editPostContent.trim() || submittingPostEdit">
              <span *ngIf="submittingPostEdit">Saving...</span>
              <span *ngIf="!submittingPostEdit">Save Changes</span>
            </button>
          </div>
        </div>

        <!-- Display mode for post content -->
        <div *ngIf="!post.post || !isEditingPost(post.post.id)">
          {{ (post && post.post && post.post.content) || '' }}
        </div>
      </div>

            <div class="post-footer">
              <span class="likes likes-bubble-container" [class.liked]="isPostLikedByCurrentUser(post)" (click)="toggleLike(post)">
                {{ (post.likes && post.likes.length) || 0 }} likes
                <span class="likes-bubble" *ngIf="post.likes && post.likes.length > 0">
                  <ng-container *ngFor="let like of post.likes">
                    <span class="bubble-user">{{ (like && like.user && like.user.username) || 'Anonymous' }}</span>
                  </ng-container>
                </span>
              </span>
              <span class="comments" (click)="toggleComments((post && post.post && post.post.id))" [class.active]="isCommentsExpanded((post && post.post && post.post.id))">
                {{ getActiveCommentsCount(post.comments) }} comments
                <span class="expand-icon">{{ isCommentsExpanded((post && post.post && post.post.id)) ? '▲' : '▼' }}</span>
              </span>
            </div>

            <!-- Expandable Comments Section -->
            <div class="comments-section" [class.expanded]="isCommentsExpanded((post && post.post && post.post.id))"
              *ngIf="isCommentsExpanded((post && post.post && post.post.id))">

              <!-- Add New Comment Section -->
              <div class="add-comment-section">
                <div class="comment-input-header">
                  <span class="comment-input-title">Add a comment</span>
                </div>
                <div class="comment-input-wrapper">
                  <div class="comment-author-avatar">
                    <span class="current-user-avatar">👤</span>
                  </div>
                  <div class="comment-input-container">
                    <textarea class="comment-input" placeholder="Share your thoughts on this post..." rows="3" maxlength="500"
                      [(ngModel)]="newCommentText[post.post?.id]" #commentTextarea>
                          </textarea>
                    <div class="comment-input-footer">
                      <div class="comment-char-count">
                        {{ (post.post?.id && newCommentText[post.post.id] && newCommentText[post.post.id].length) || 0 }}/500
                      </div>
                      <div class="comment-actions">
                        <button class="comment-cancel-btn" (click)="clearComment(post.post.id)"
                          *ngIf="post.post?.id && newCommentText[post.post.id] && newCommentText[post.post.id].length > 0">
                          Cancel
                        </button>
                        <button class="comment-submit-btn" (click)="submitComment(post.post.id)"
                          [disabled]="!post.post?.id || !(newCommentText[post.post.id] && newCommentText[post.post.id].trim()) || submittingComment[post.post.id]">
                          <span *ngIf="post.post?.id && submittingComment[post.post.id]">Posting...</span>
                          <span *ngIf="!post.post?.id || !submittingComment[post.post.id]">Post Comment</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
<div *ngIf="getActiveCommentsCount(post.comments) > 0">
  <div class="comments-header">
    <h4>Comments ({{ getActiveCommentsCount(post.comments) }})</h4>
  </div>
  <div class="comments-list">
    <div *ngFor="let comment of post.comments">
      <div class="comment-item" *ngIf="comment.active">
        <div class="comment-header">
          <div class="comment-user-info">
            <span class="comment-author">{{ (comment.user && comment.user.username) || 'Anonymous' }}</span>
            <span class="comment-email">@{{ (comment.user && comment.user.id) || 'unknown' }}</span>
          </div>

          <!-- Comment Actions Menu -->
          <div class="comment-actions-wrapper">
            <button class="comment-actions-btn"
            (click)="toggleCommentOptions(comment); $event.stopPropagation()">⋯</button>
            <div class="comment-options-bubble" [class.show]="comment.showOptions">
              <button (click)="shareComment(comment)">🔗 Share</button>
              <button *ngIf="comment.user && comment.user.id === getCurrentUserId()" (click)="editComment(comment)">✏️ Edit</button>
              <button *ngIf="comment.user && comment.user.id === getCurrentUserId()" (click)="deleteComment(comment)">🗑️ Delete</button>
            </div>
          </div>
        </div>
        <div class="comment-content">
          <!-- Edit mode for comment content -->
          <div *ngIf="isEditingComment(comment.id)" class="comment-edit-mode">
            <div class="edit-input-container">
              <textarea
                class="comment-edit-input"
                [(ngModel)]="editCommentContent"
                rows="3"
                maxlength="500"
                placeholder="Edit your comment...">
              </textarea>
              <div class="edit-char-count">{{ editCommentContent.length }}/500</div>
            </div>
            <div class="edit-actions">
              <button class="edit-cancel-btn" (click)="cancelCommentEdit()" [disabled]="submittingCommentEdit">
                Cancel
              </button>
              <button class="edit-save-btn" (click)="saveCommentEdit(comment)"
                      [disabled]="!editCommentContent.trim() || submittingCommentEdit">
                <span *ngIf="submittingCommentEdit">Saving...</span>
                <span *ngIf="!submittingCommentEdit">Save Changes</span>
              </button>
            </div>
          </div>

          <!-- Display mode for comment content -->
          <div *ngIf="!isEditingComment(comment.id)">
            {{ comment.content }}
          </div>
        </div>
      </div>
    </div>
</div>


              <!-- No Comments Message -->
              <div *ngIf="getActiveCommentsCount(post.comments) === 0" class="no-comments-message">
                <div class="no-comments-icon">💭</div>
                <p>Be the first to comment on this post!</p>
              </div>
            </div>


    </div>
  </div>
</div>
