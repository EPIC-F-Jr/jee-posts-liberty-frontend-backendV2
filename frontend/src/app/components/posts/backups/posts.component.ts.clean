import { Injector, TemplateRef, Component, OnInit, AfterViewInit, HostListener, ViewChildren, QueryList, ViewChild, ElementRef, OnDestroy, NgZone } from '@angular/core';
import { PostService } from '../../services/post.service';
import { PostDTO, PostWithOptions } from '../../models/post-dto';
import { trigger, state, style, transition, animate } from '@angular/animations';
import { Like } from 'src/app/models/like';
import { LikeService } from 'src/app/services/like.service';
import { Subscription } from 'rxjs';

@Component({
  selector: 'app-posts',
  templateUrl: './posts.component.html',
  styleUrls: ['./posts.component.css'],
  animations: [
    trigger('dropdownAnimation', [
      transition(':enter', [
        style({ opacity: 0, transform: 'translateY(-10px)' }),
        animate('150ms ease-out', style({ opacity: 1, transform: 'translateY(0)' }))
      ]),
      transition(':leave', [
        animate('100ms ease-in', style({ opacity: 0, transform: 'translateY(-10px)' }))
      ])
    ])
  ]
})

export class PostsComponent implements OnInit, AfterViewInit, OnDestroy {

  // ==========================================
  // COMPONENT STATE PROPERTIES
  // ==========================================

  // Core post data and UI state
  postDTO: PostDTO[] = [];
  loading = false;
  error: string | null = null;

  // Subscription to new post events
  private newPostSubscription: Subscription | null = null;

  // DOM references and animation observers
  @ViewChildren('postCard') postCards!: QueryList<ElementRef>;
  private intersectionObserver!: IntersectionObserver | null;
  private flyoutObserver!: IntersectionObserver | null;
  private viewportHeight = (typeof window !== 'undefined') ? window.innerHeight : 0;
  private observedSet = new WeakSet<Element>();
  private flyoutObservedSet = new WeakSet<Element>();

  // Animation state tracking
  private animationStates = new WeakMap<Element, {
    locked: boolean;
    state: 'initial' | 'entering' | 'loaded' | 'exiting';
    pendingDirection?: 'left' | 'right' | 'bottom';
  }>();

  // Configuration properties
  private scrollRecheckEnabled: boolean = true;
  private readonly SCROLL_RECHECK_DELAY = 200;
  private readonly ANIMATION_TIMEOUT = 2000;
  private scrollRecheckTimeout: number | null = null;

  // Pre-bound callbacks to avoid closure re-creation
  private boundHandleIntersection: IntersectionObserverCallback;
  private boundHandleFlyout: IntersectionObserverCallback;
  private boundScrollRecheck: () => void;

  // Viewport height caching for performance
  private cachedViewportHeight: number = 0;
  private readonly updateViewportHeight = () => {
    this.cachedViewportHeight = window.innerHeight;
  };

  // Post edit state
  editingPostId: number | null = null;
  editPostContent: string = '';
  submittingPostEdit: boolean = false;

  constructor(
    private likeService: LikeService,
    private postService: PostService,
    private ngZone: NgZone,
  ) {
    // Pre-bind callbacks to avoid repeated closure creation
    this.boundHandleIntersection = this.handleIntersection.bind(this);
    this.boundHandleFlyout = this.handleFlyout.bind(this);
    this.boundScrollRecheck = this.debounce(this.performScrollRecheck.bind(this), this.SCROLL_RECHECK_DELAY);

    // Set up subscription to new posts (if you have a service that emits new posts)
    // this.newPostSubscription = this.postService.newPost$.subscribe({
    //   next: (newPost) => this.handleNewPost(newPost),
    //   error: (error) => console.error('Error in new post subscription:', error)
    // });
  }

  // ==========================================
  // LIFECYCLE METHODS
  // ==========================================

  ngOnInit() {
    this.loadPosts();

    // Set up throttled viewport height caching for smooth animations
    if (typeof window !== 'undefined') {
      this.cachedViewportHeight = window.innerHeight;
      window.addEventListener('resize', this.updateViewportHeight, { passive: true });
    }

    // Set up debounced scroll-based animation state verification.
    // Ensures animation consistency when intersection observers might miss events.
    if (typeof window !== 'undefined' && this.scrollRecheckEnabled) {
      window.addEventListener('scroll', this.boundScrollRecheck, { passive: true });
    }
  }

  ngAfterViewInit() {
    this.setupIntersectionObserver();
    this.setupThrottledObservation();
  }

  ngOnDestroy() {
    // Clean up observers
    if (this.intersectionObserver) {
      this.intersectionObserver.disconnect();
    }
    if (this.flyoutObserver) {
      this.flyoutObserver.disconnect();
    }

    // Clean up event listeners
    if (typeof window !== 'undefined') {
      window.removeEventListener('resize', this.updateViewportHeight);
      window.removeEventListener('scroll', this.boundScrollRecheck);
    }

    // Clean up timeouts
    if (this.scrollRecheckTimeout) {
      clearTimeout(this.scrollRecheckTimeout);
    }

    // Clean up subscriptions
    if (this.newPostSubscription) {
      this.newPostSubscription.unsubscribe();
    }
  }

  // ==========================================
  // COMMENT FUNCTIONALITY - DELEGATED TO COMMENTS COMPONENT
  // ==========================================

  expandedComments: Set<number> = new Set();

  toggleComments(postId: number) {
    if (this.expandedComments.has(postId)) {
      this.expandedComments.delete(postId);
    } else {
      this.expandedComments.add(postId);
    }
  }

  isCommentsExpanded(postId: number): boolean {
    return this.expandedComments.has(postId);
  }

  onCommentAdded(comment: any) {
    // Handle comment added event if needed
    console.log('Comment added:', comment);
  }

  // ==========================================
  // DATA LOADING AND CORE FUNCTIONALITY
  // ==========================================

  loadPosts(): void {
    this.loading = true;
    this.error = null;

    this.postService.getAllPosts().subscribe({
      next: (posts) => {
        this.postDTO = posts.map(post => ({
          ...post,
          showOptions: false
        }));
        this.loading = false;

        // Set up staggered card observation after DOM updates
        setTimeout(() => this.observePostCardsWithStagger(), 50);
      },
      error: (error) => {
        console.error('Error loading posts:', error);
        this.error = error.message || 'Failed to load posts';
        this.loading = false;
      }
    });
  }

  // ==========================================
  // POST ACTIONS
  // ==========================================

  @ViewChildren('postActions') postActionsList!: QueryList<ElementRef>;

  @HostListener('document:click', ['$event'])
  onDocumentClick(event: Event) {
    const target = event.target as HTMLElement;

    // Close post options if clicking outside
    if (!target.closest('.post-actions-wrapper')) {
      this.closeAllOptions();
    }
  }

  closeAllOptions() {
    this.postDTO.forEach(post => {
      post.showOptions = false;
    });
  }

  togglePostOptions(post: PostDTO) {
    // Close all other options first
    this.postDTO.forEach(p => {
      if (p !== post) {
        p.showOptions = false;
      }
    });
    post.showOptions = !post.showOptions;
  }

  openShareOptions(post: any) {
    console.log('Share', post);
    post.showOptions = false;
  }

  editPost(post: PostDTO) {
    if (post.post) {
      this.editingPostId = post.post.id;
      this.editPostContent = post.post.content;
      post.showOptions = false;
    }
  }

  isEditingPost(postId: number): boolean {
    return this.editingPostId === postId;
  }

  cancelPostEdit() {
    this.editingPostId = null;
    this.editPostContent = '';
    this.submittingPostEdit = false;
  }

  savePostEdit(post: PostDTO) {
    if (!this.editPostContent.trim() || !post.post) {
      return;
    }

    this.submittingPostEdit = true;

    const updateData = {
      content: this.editPostContent.trim()
    };

    this.postService.updatePost(post.post.id, updateData).subscribe({
      next: (updatedPost) => {
        if (post.post) {
          post.post.content = this.editPostContent.trim();
          post.post.updatedAt = updatedPost.updatedAt || new Date().toISOString();
        }
        this.cancelPostEdit();
        console.log('Post updated successfully');
      },
      error: (error) => {
        console.error('Error updating post:', error);
        this.submittingPostEdit = false;
      }
    });
  }

  deletePost(post: PostDTO): void {
    if (!post.post?.id) return;

    const postId = post.post.id;
    console.log('Attempting to delete post with ID:', postId);

    this.postService.deletePost(postId).subscribe({
      next: (response) => {
        console.log('Post deleted successfully:', response);
        // Remove the post from the local array
        this.postDTO = this.postDTO.filter(p => p.post?.id !== postId);
        post.showOptions = false;
      },
      error: (err) => {
        console.error('Error deleting post:', err);
        alert('Failed to delete post. Check console for details.');
      }
    });
  }

  // ==========================================
  // LIKE FUNCTIONALITY
  // ==========================================

  private getCurrentUserId(): number {
    return 1; // This should come from your authentication service
  }

  private getCurrentUsername(): string {
    return "testuser"; // This should come from your authentication service
  }

  isPostLikedByCurrentUser(post: PostDTO): boolean {
    const currentUserId = this.getCurrentUserId();
    if (!post.likes) {
      return false;
    }
    return post.likes.some(like => {
      return like.user && like.user.id === currentUserId;
    });
  }

  toggleLike(post: PostDTO): void {
    if (!post.post?.id) return;

    const postId = post.post.id;
    const currentUserId = this.getCurrentUserId();
    const isCurrentlyLiked = this.isPostLikedByCurrentUser(post);

    if (isCurrentlyLiked) {
      // Unlike the post
      const likeToRemove = post.likes?.find(like => like.user?.id === currentUserId);
      if (likeToRemove?.id) {
        this.likeService.deleteLike(likeToRemove.id).subscribe({
          next: () => {
            // Remove the like from the local data
            if (post.likes) {
              post.likes = post.likes.filter(like => like.id !== likeToRemove.id);
            }
            console.log('Post unliked successfully');
          },
          error: (error) => {
            console.error('Error unliking post:', error);
          }
        });
      }
    } else {
      // Like the post
      const likeData = {
        postId: postId,
        userId: currentUserId
      };

      this.likeService.createLike(likeData).subscribe({
        next: (newLike) => {
          // Add the new like to the local data
          if (!post.likes) {
            post.likes = [];
          }
          post.likes.push(newLike);
          console.log('Post liked successfully');
        },
        error: (error) => {
          console.error('Error liking post:', error);
        }
      });
    }
  }

  // ==========================================
  // UI UTILITY METHODS
  // ==========================================

  getCurrentDate(): string {
    const date = new Date();
    const formatter = new Intl.DateTimeFormat('en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric'
    });
    return formatter.format(date);
  }

  // ==========================================
  // ANIMATION METHODS (keeping existing implementation)
  // ==========================================

  private setupIntersectionObserver() {
    const rootMargin = typeof window !== 'undefined' ?
      `${Math.round(window.innerHeight * 0.2)}px` : '100px';

    this.intersectionObserver = new IntersectionObserver(
      this.boundHandleIntersection,
      {
        root: null,
        rootMargin: rootMargin,
        threshold: [0, 0.1, 0.5, 0.9, 1.0]
      }
    );
  }

  private handleIntersection(entries: IntersectionObserverEntry[]): void {
    requestAnimationFrame(() => {
      entries.forEach(entry => {
        const element = entry.target as HTMLElement;
        const state = this.animationStates.get(element);

        if (!state || state.locked) return;

        this.handleCardStateChange(element, entry.isIntersecting, entry.intersectionRatio);
      });
    });
  }

  private handleCardStateChange(element: HTMLElement, isIntersecting: boolean, ratio: number): void {
    const state = this.animationStates.get(element);
    if (!state) return;

    // Prevent simultaneous animations
    if (state.locked) return;

    if (isIntersecting && state.state === 'initial') {
      this.handleCardEntering(element);
    } else if (state.state === 'entering' && ratio > 0.5) {
      this.handleCardLoaded(element);
    } else if (!isIntersecting && state.state === 'loaded') {
      this.handleCardExiting(element);
    }
  }

  private handleCardEntering(element: HTMLElement): void {
    const rect = element.getBoundingClientRect();
    const isInBottomHalf = rect.top > this.cachedViewportHeight * 0.6;

    if (isInBottomHalf) {
      this.applyBottomEntrance(element);
    } else {
      this.applyStandardEntrance(element);
    }
  }

  private handleCardLoaded(element: HTMLElement): void {
    const state = this.animationStates.get(element);
    if (state) {
      state.state = 'loaded';
      state.locked = false;
    }

    // Add to flyout observer
    this.addToFlyoutObserver(element);
  }

  private handleCardExiting(element: HTMLElement): void {
    if (this.flyoutObservedSet.has(element)) {
      const direction = this.getFlyoutDirection(element);
      this.applyFlyoutAnimation(element, direction);
    }
  }

  private applyAnimation(
    element: HTMLElement,
    animationClass: string,
    onComplete?: () => void
  ): void {
    const state = this.animationStates.get(element);
    if (!state) return;

    state.locked = true;
    element.classList.add(animationClass);

    if (onComplete) {
      this.setupTransitionEndListener(element, onComplete);
    } else {
      // Auto-unlock after timeout if no completion callback
      setTimeout(() => {
        if (state) state.locked = false;
      }, this.ANIMATION_TIMEOUT);
    }
  }

  private getFlyoutDirection(element: HTMLElement): 'left' | 'right' | 'bottom' {
    const rect = element.getBoundingClientRect();
    const index = parseInt(element.getAttribute('data-index') || '0');

    // Cards in lower half of viewport exit downward
    if (rect.top > this.cachedViewportHeight * 0.7) {
      return 'bottom';
    }

    // Even/odd alternation for left/right
    return (index % 2 === 0) ? 'left' : 'right';
  }

  private addToFlyoutObserver(element: HTMLElement): void {
    this.ngZone.runOutsideAngular(() => {
      if (this.flyoutObserver && !this.flyoutObservedSet.has(element)) {
        this.flyoutObserver.observe(element);
        this.flyoutObservedSet.add(element);
      }
    });
  }

  private applyStandardEntrance(element: HTMLElement, onComplete?: () => void): void {
    this.applyAnimation(element, 'animate-in', onComplete);
  }

  private applyBottomEntrance(element: HTMLElement, onComplete?: () => void): void {
    this.applyAnimation(element, 'animate-in-from-bottom', onComplete);
  }

  private applyFlyoutAnimation(element: HTMLElement, direction: 'left' | 'right' | 'bottom'): void {
    const animationClass = direction === 'bottom' ? 'animate-out-bottom' :
                          direction === 'left' ? 'animate-out-left' : 'animate-out-right';
    this.applyAnimation(element, animationClass);
  }

  private setupTransitionEndListener(element: HTMLElement, callback: () => void): void {
    let completed = false;

    const cleanup = () => {
      if (!completed) {
        completed = true;
        element.removeEventListener('transitionend', onTransitionEnd);
        callback();
      }
    };

    const onTransitionEnd = () => cleanup();

    element.addEventListener('transitionend', onTransitionEnd, { once: true });

    // Safety fallback
    setTimeout(() => cleanup(), this.ANIMATION_TIMEOUT);
  }

  private setupFlyoutObserver(): void {
    const rootMargin = typeof window !== 'undefined' ?
      `${Math.round(window.innerHeight * -0.3)}px` : '-150px';

    this.flyoutObserver = new IntersectionObserver(
      this.boundHandleFlyout,
      {
        root: null,
        rootMargin: rootMargin,
        threshold: [0, 0.1]
      }
    );
  }

  private handleFlyout(entries: IntersectionObserverEntry[]): void {
    requestAnimationFrame(() => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) {
          this.handleFlyoutExit(entry.target as HTMLElement);
        }
      });
    });
  }

  private handleFlyoutExit(element: HTMLElement): void {
    const direction = this.getFlyoutDirection(element);
    this.applyFlyoutAnimation(element, direction);
  }

  private observePostCardsWithStagger(): void {
    if (!this.intersectionObserver) return;

    this.ngZone.runOutsideAngular(() => {
      this.postCards.forEach((cardRef, index) => {
        const element = cardRef.nativeElement;

        if (!this.observedSet.has(element)) {
          // Initialize animation state
          this.animationStates.set(element, {
            locked: false,
            state: 'initial'
          });

          // Add to observer with slight delay for staggered observation
          setTimeout(() => {
            if (this.intersectionObserver) {
              this.intersectionObserver.observe(element);
              this.observedSet.add(element);
            }
          }, index * 50);
        }
      });
    });
  }

  private setupThrottledObservation(): void {
    // Set up flyout observer
    this.setupFlyoutObserver();
  }

  public toggleScrollRecheck(enabled: boolean): void {
    this.scrollRecheckEnabled = enabled;

    if (typeof window !== 'undefined') {
      if (enabled) {
        window.addEventListener('scroll', this.boundScrollRecheck, { passive: true });
      } else {
        window.removeEventListener('scroll', this.boundScrollRecheck);
      }
    }
  }

  private performScrollRecheck(): void {
    // Implementation for scroll recheck if needed
  }

  private debounce<T extends (...args: any[]) => any>(
    func: T,
    delay: number
  ): (...args: Parameters<T>) => void {
    let timeoutId: number | null = null;

    return (...args: Parameters<T>) => {
      if (timeoutId !== null) {
        clearTimeout(timeoutId);
      }

      timeoutId = window.setTimeout(() => {
        timeoutId = null;
        func(...args);
      }, delay);
    };
  }
}
