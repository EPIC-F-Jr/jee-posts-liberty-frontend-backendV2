/* Existing styles would remain the same, plus these new comment input styles */

.add-comment-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 1rem;
  margin-bottom: 1rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.comment-input-header {
  margin-bottom: 0.75rem;
}

.comment-input-title {
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.9rem;
}

.comment-input-wrapper {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
}

.comment-author-avatar {
  flex-shrink: 0;
}

.current-user-avatar {
  display: inline-block;
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
}

.comment-input-container {
  flex: 1;
}

.comment-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 0.75rem;
  color: white;
  font-family: inherit;
  font-size: 0.9rem;
  resize: vertical;
  min-height: 60px;
  transition: all 0.3s ease;
}

.comment-input:focus {
  outline: none;
  border-color: rgba(102, 126, 234, 0.5);
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.2);
}

.comment-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.comment-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.5rem;
}

.comment-char-count {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.5);
}

.comment-actions {
  display: flex;
  gap: 0.5rem;
}

.comment-cancel-btn,
.comment-submit-btn {
  padding: 0.5rem 1rem;
  border-radius: 6px;
  border: none;
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
}

.comment-cancel-btn {
  background: transparent;
  color: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.comment-cancel-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.8);
}

.comment-submit-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.comment-submit-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.comment-submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.no-comments-message {
  text-align: center;
  padding: 2rem 1rem;
  color: rgba(255, 255, 255, 0.6);
}

.no-comments-icon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.no-comments-message p {
  margin: 0;
  font-style: italic;
}

/* Enhanced comments section visibility */
.comments-section.expanded {
  max-height: none;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12px;
  margin-top: 1rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.comment-user-info {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.comment-actions-wrapper {
  position: relative;
  display: inline-block;
  z-index: 10010;
}

.comment-actions-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.8);
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 4px;
  transition: all 0.2s ease;
  font-size: 16px;
  line-height: 1;
  min-width: 30px;
  min-height: 30px;
}

.comment-actions-btn:hover {
  background-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 1);
}

.comment-options-bubble {
  position: absolute;
  top: 100%;
  right: 0;
  background: white;
  color: black;
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.25);
  min-width: 140px;
  display: none;
  flex-direction: column;
  z-index: 9999;
  border: 1px solid rgba(0,0,0,0.1);
  margin-top: 5px;
}

.comment-options-bubble.show {
  display: flex !important;
}

.comment-options-bubble button {
  border: none;
  background: none;
  padding: 12px 16px;
  text-align: left;
  cursor: pointer;
  font-size: 14px;
  transition: background-color 0.2s ease;
  white-space: nowrap;
  border-radius: 0;
}

.comment-options-bubble button:hover {
  background: rgba(0,0,0,0.08);
}

.comment-options-bubble button:first-child {
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
}

.comment-options-bubble button:last-child {
  border-bottom-left-radius: 8px;
  border-bottom-right-radius: 8px;
}

/* Allow the options to overflow all containers */
.comments-section {
  overflow: visible !important;
}

.comments-section.expanded {
  overflow: visible !important;
}

.post-card {
  overflow: visible !important;
}

.comment-item {
  overflow: visible !important;
}

.comment-header {
  overflow: visible !important;
}

.comment-actions-wrapper {
  overflow: visible !important;
}

.posts-container {
  overflow: visible !important;
}

.comments-list {
  overflow: visible !important;
}

/* =================================================================
   DARK MODE SUPPORT
   ================================================================= */

@media (prefers-color-scheme: dark) {
  /* Comment Actions Button - Dark Mode */
  .comment-actions-btn {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.9);
  }

  .comment-actions-btn:hover {
    background-color: rgba(0, 0, 0, 0.5);
    color: rgba(255, 255, 255, 1);
    border-color: rgba(0, 0, 0, 0.6);
  }

  /* Comment Options Dropdown - Dark Mode */
  .comment-options-bubble {
    background: rgba(30, 30, 30, 0.95);
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  }

  .comment-options-bubble button {
    color: rgba(255, 255, 255, 0.9);
  }

  .comment-options-bubble button:hover {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 1);
  }

  /* Comment Input Section - Dark Mode */
  .add-comment-section {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .comment-input {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.9);
  }

  .comment-input:focus {
    border-color: rgba(102, 126, 234, 0.7);
    background: rgba(0, 0, 0, 0.5);
  }

  .comment-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  /* Comment Cancel Button - Dark Mode */
  .comment-cancel-btn {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .comment-cancel-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Comments Section - Dark Mode */
  .comments-section.expanded {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Comment Items - Dark Mode */
  .comment-item {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .comment-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  /* Comment Author and Content - Dark Mode */
  .comment-author {
    color: rgba(255, 255, 255, 0.9);
  }

  .comment-email {
    color: rgba(255, 255, 255, 0.6);
  }

  .comment-content {
    color: rgba(255, 255, 255, 0.8);
  }

  /* Character Count - Dark Mode */
  .comment-char-count {
    color: rgba(255, 255, 255, 0.4);
  }

  /* Comments Header - Dark Mode */
  .comments-header h4 {
    color: rgba(255, 255, 255, 0.9);
  }

  /* No Comments Message - Dark Mode */
  .no-comments-message {
    color: rgba(255, 255, 255, 0.5);
  }

  /* Comment Input Title - Dark Mode */
  .comment-input-title {
    color: rgba(255, 255, 255, 0.8);
  }
}

/* =================================================================
   EDIT MODE STYLING
   ================================================================= */

/* Post Edit Mode */
.post-edit-mode {
  margin: 0.5rem 0;
}

.edit-input-container {
  position: relative;
  margin-bottom: 0.75rem;
}

.post-edit-input,
.comment-edit-input {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid rgba(102, 126, 234, 0.5);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.95);
  font-family: inherit;
  font-size: 0.95rem;
  line-height: 1.5;
  resize: vertical;
  min-height: 80px;
  transition: all 0.3s ease;
}

.post-edit-input:focus,
.comment-edit-input:focus {
  outline: none;
  border-color: rgba(102, 126, 234, 0.8);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.edit-char-count {
  position: absolute;
  bottom: 0.5rem;
  right: 0.75rem;
  font-size: 0.8rem;
  color: rgba(0, 0, 0, 0.5);
  background: rgba(255, 255, 255, 0.9);
  padding: 0.2rem 0.4rem;
  border-radius: 6px;
  pointer-events: none;
}

.edit-actions {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}

.edit-cancel-btn,
.edit-save-btn {
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
}

.edit-cancel-btn {
  background: rgba(0, 0, 0, 0.1);
  color: rgba(0, 0, 0, 0.7);
  border: 1px solid rgba(0, 0, 0, 0.2);
}

.edit-cancel-btn:hover:not(:disabled) {
  background: rgba(0, 0, 0, 0.15);
  color: rgba(0, 0, 0, 0.8);
}

.edit-save-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.edit-save-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.edit-cancel-btn:disabled,
.edit-save-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* Comment Edit Mode Specific */
.comment-edit-mode {
  margin: 0.5rem 0;
}

.comment-edit-input {
  min-height: 60px;
}

/* Dark Mode for Edit Controls */
@media (prefers-color-scheme: dark) {
  .post-edit-input,
  .comment-edit-input {
    background: rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.9);
  }

  .post-edit-input:focus,
  .comment-edit-input:focus {
    background: rgba(0, 0, 0, 0.5);
    border-color: rgba(102, 126, 234, 0.7);
    color: rgba(255, 255, 255, 1);
  }

  .post-edit-input::placeholder,
  .comment-edit-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .edit-char-count {
    color: rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.6);
  }

  .edit-cancel-btn {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .edit-cancel-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
  }
}
